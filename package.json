{
  "name": "synergy",
  "version": "1.0.0",
  "private": true,
  "description": "Organization website built with Next.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"tests/unit/**/*.test.ts\"",
    "test:integration": "node --import tsx --test --test-concurrency=1 \"tests/integration/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:check": "tsx scripts/db-check.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:migrate:postgres": "tsx scripts/migrate-postgres-to-mongodb.ts",
    "admin:user": "tsx scripts/admin-user.ts",
    "jobs:maintenance": "tsx scripts/maintenance.ts",
    "test:smtp-sink": "tsx scripts/test-smtp-sink.ts"
  },
  "keywords": [
    "nextjs",
    "organization-site"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@aws-sdk/s3-request-presigner": "^3.1127.0",
    "framer-motion": "^12.38.0",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "lucide-react": "^1.7.0",
    "mongoose": "^9.10.1",
    "next": "^16.3.4",
    "nodemailer": "^10.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@next/env": "^16.3.4",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^20.19.17",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/smtp-server": "^3.5.13",
    "eslint": "^9.38.0",
    "eslint-config-next": "^16.3.4",
    "pg": "^8.23.0",
    "smtp-server": "^3.19.13",
    "tailwindcss": "^4.1.12",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
