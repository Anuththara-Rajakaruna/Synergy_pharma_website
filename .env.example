# ─────────────────────────────────────────────────────────────────────────────
# Synergy Pharma Careers Portal — Environment Variables
# Copy this file to .env.local and fill in real values before starting the app.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# Secret key used to sign admin session cookies (HMAC-SHA256).
# Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Admin panel password. Must be changed before any public deployment.
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# Optional: HR inbox for new application notifications (future feature)
# HR_NOTIFICATION_EMAIL=hr@synergypharma.lk

# Optional: SMTP for confirmation emails (future feature)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=noreply@synergypharma.lk
# SMTP_PASS=replace-with-smtp-password
# SMTP_FROM=Synergy Careers <noreply@synergypharma.lk>
