# ─────────────────────────────────────────────────────────────────────────────
# Synergy Pharma Website — Environment Variables
# Copy this file to .env.local and fill in real values before starting the app.
# NEVER commit .env.local (or any real secret) to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Site ────────────────────────────────────────────────────────────────────

# Public production URL, no trailing slash. Used in sitemap.xml, robots.txt,
# canonical tags, and Open Graph metadata. Safe to expose to the browser
# (NEXT_PUBLIC_ prefix) — it is not a secret.
NEXT_PUBLIC_SITE_URL=https://www.synergypharma.lk

# ── Database (required) ───────────────────────────────────────────────────────
# Postgres connection string. Any standard provider works (Neon, Supabase,
# Vercel Postgres, Railway, RDS, self-hosted). Run `npm run db:setup` once
# after setting this to create tables and seed job postings.
DATABASE_URL=postgresql://user:password@host:5432/database

# ── Object storage for CV uploads (required) ─────────────────────────────────
# S3-compatible storage for uploaded CV PDFs. Works with AWS S3, Cloudflare R2,
# Backblaze B2, Supabase Storage, or any S3-compatible provider.
S3_BUCKET=replace-with-your-bucket-name
S3_REGION=auto
# Only needed for non-AWS providers (e.g. Cloudflare R2's account endpoint).
# Leave unset when using real AWS S3.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=replace-with-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-secret-access-key

# ── Admin authentication (required) ───────────────────────────────────────────

# Secret key used to sign admin session cookies (HMAC-SHA256).
# Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Admin panel password. Must be changed before any public deployment.
ADMIN_PASSWORD=replace-with-a-strong-admin-password

# ── Email (required for contact/application notifications) ───────────────────

# HR inbox that receives new job application and talent-pool notifications.
HR_NOTIFICATION_EMAIL=hr@synergypharma.lk

# SMTP credentials used to send applicant confirmation emails and HR
# notifications. Any SMTP provider works (Google Workspace, Microsoft 365,
# SendGrid, Postmark, Amazon SES, etc.).
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@synergypharma.lk
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="Synergy Pharmaceuticals <noreply@synergypharma.lk>"

# ── Analytics (optional) ──────────────────────────────────────────────────────

# GA4 measurement ID (starts with "G-"). Leave unset to disable analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
