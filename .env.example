# -----------------------------------------------------------------------------
# Synergy Pharmaceutical Corporation website: environment variables
#
# Local development:  cp .env.example .env.local
#   Everything except the GOOGLE_* block works as it stands, together with the
#   SMTP capture server from `npm run test:smtp-sink` (README.md). There is no
#   local emulator for Google Sheets or Google Drive, so the GOOGLE_* values
#   have to be real: create a spreadsheet and a Drive folder of your own for
#   development and never point a developer machine at the production ones.
#
# Production: set every variable in the hosting provider's dashboard (Vercel:
#   Project Settings > Environment Variables). Never commit real credentials;
#   the placeholder values below are rejected on purpose. DEPLOYMENT.md lists
#   each variable with its production value.
#
# Check a configuration with `npm run sheets:check`. The server also logs every
# problem at start-up as a `config.problem` event.
# -----------------------------------------------------------------------------

# --- Site --------------------------------------------------------------------

# Public URL of the site, without a trailing slash. Used for canonical URLs,
# sitemap.xml, links in emails and the same-origin check on form submissions.
# NEXT_PUBLIC_ variables are compiled into the build: redeploy after changing.
# Production: https://www.synergypharma.lk (https is required in production).
# Do not leave this set to an empty value; remove the line instead.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Empty disables analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- Google Sheets and Google Drive (required) -------------------------------
#
# There is no database server. Every record lives in ONE Google Spreadsheet, one
# tab per record type (Jobs, Applications, TalentPool, Documents, Notes,
# StatusHistory, TalentActivity, AdminUsers, AdminSessions, AuditLog,
# EmailOutbox, Settings), and every CV lives in ONE Google Drive folder.
# `npm run sheets:setup` creates the tabs and their header rows in a spreadsheet
# you have already created; `npm run sheets:check` verifies the configuration
# and that the service account can really reach both.
#
# One-time setup:
#   1. Google Cloud console > pick or create a project > enable both the
#      "Google Sheets API" and the "Google Drive API".
#   2. IAM & Admin > Service Accounts > create one > Keys > Add key > JSON.
#      The downloaded file contains client_email, private_key, private_key_id.
#   3. Create the spreadsheet, then Share it with the service account's
#      client_email address as an Editor.
#   4. Create the Drive folder, then Share it with the same address as an
#      Editor (on a Shared Drive: "Content manager").
#
# Steps 3 and 4 are the ones everybody forgets. A service account can only see
# what has been shared with it, and Google reports an unshared file as "not
# found" rather than as a permission error, so the symptom is a 404 for an id
# that is perfectly correct.
#
# !! STORAGE QUOTA - read this before going live !!
# A service account has no Drive storage quota of its own. If
# GOOGLE_DRIVE_FOLDER_ID points at a folder inside somebody's personal My
# Drive, uploads work at first and then start failing permanently with
# storageQuotaExceeded. The two supported fixes are:
#   (a) recommended: put the folder on a SHARED DRIVE and set
#       GOOGLE_DRIVE_SHARED_DRIVE_ID below. Files then belong to the Shared
#       Drive, which has its own quota. Needs Google Workspace.
#   (b) otherwise: grant the service account domain-wide delegation for the
#       scopes https://www.googleapis.com/auth/spreadsheets and
#       https://www.googleapis.com/auth/drive, and set GOOGLE_IMPERSONATE_USER
#       to a real Workspace user. Files are then created as that user and count
#       against that user's quota.
#
# The maximum CV size is not an environment variable: it is
# UPLOAD_LIMITS.cvMaxBytes in src/lib/careers/constants.ts.

# The service account's address, the client_email field of the key file. It
# always ends in .iam.gserviceaccount.com. Not a person's Google account.
GOOGLE_SERVICE_ACCOUNT_EMAIL=replace-with-service-account@your-project.iam.gserviceaccount.com

# The private_key field of the key file, including the
# -----BEGIN PRIVATE KEY----- and -----END PRIVATE KEY----- lines. Three shapes
# are accepted, so paste whichever survives your hosting dashboard intact:
#   * the PEM with real newlines (in this file, wrap it in double quotes),
#   * one line with literal \n escapes, exactly as it appears inside the JSON
#     key file - this is what most dashboards produce,
#   * base64 of the whole PEM (base64 -w0 key.pem), when a dashboard mangles
#     both of the above.
# This is a credential: keep it out of git, out of logs and out of screenshots.
GOOGLE_PRIVATE_KEY="replace-with-the-private_key-field-from-the-service-account-json"

# Optional. The private_key_id field of the key file. It is sent as the JWT
# "kid" header, which makes key rotation unambiguous while a service account
# has more than one active key. Leave empty if you do not need that.
# GOOGLE_PRIVATE_KEY_ID=

# Optional alternative to the three variables above: the downloaded key file
# verbatim, or base64 of it (base64 -w0 key.json), which is the practical form
# for dashboards that cannot hold a multi-line value. Fields are only taken
# from here when the matching variable above is empty, so you can supply the
# JSON and still override, say, the impersonated user.
# GOOGLE_SERVICE_ACCOUNT_JSON=

# The spreadsheet that holds the data. Copy the id from the sheet URL:
#   https://docs.google.com/spreadsheets/d/<THIS PART>/edit#gid=0
# Use a different spreadsheet for development than for production.
GOOGLE_SHEETS_SPREADSHEET_ID=replace-with-the-spreadsheet-id-from-its-url

# The Drive folder that holds the CVs. Copy the id from the folder URL:
#   https://drive.google.com/drive/folders/<THIS PART>
# The application creates its own subfolders (Applications, TalentPool and a
# _staging folder for uploads in flight) inside it.
GOOGLE_DRIVE_FOLDER_ID=replace-with-the-drive-folder-id-from-its-url

# Optional, strongly recommended in production: the id of the Shared Drive that
# contains GOOGLE_DRIVE_FOLDER_ID. This is the (a) fix for the storage quota
# problem above. Open the Shared Drive itself and copy the id from the URL:
#   https://drive.google.com/drive/folders/<THIS PART>
# A Shared Drive id is the id of its top level and usually begins with 0A.
# Leave empty when the folder is in an ordinary My Drive.
# GOOGLE_DRIVE_SHARED_DRIVE_ID=

# Optional: the Workspace user the service account acts as (the (b) fix above).
# Only works after domain-wide delegation has been granted to the service
# account's client id for the Sheets and Drive scopes; without that, every
# request fails with unauthorized_client. Leave empty when using a Shared Drive.
# GOOGLE_IMPERSONATE_USER=

# --- Email (SMTP) ------------------------------------------------------------

# Every message is written to the EmailOutbox tab first and delivered in the
# background; failed deliveries are retried by the maintenance job.
# Production: the provider's host, port 587 (STARTTLS, enforced) or 465 with
# SMTP_SECURE=true, plus SMTP_USER / SMTP_PASS.
SMTP_HOST=127.0.0.1
SMTP_PORT=2525

# true = implicit TLS (port 465). Defaults to true for port 465, otherwise false
# (STARTTLS, which is required unless SMTP_ALLOW_INSECURE_LOCAL applies).
SMTP_SECURE=false

# Local development only: allow plain-text SMTP to a mail catcher. Accepted only
# when SMTP_HOST is localhost, 127.0.0.1 or ::1. Remove it in production.
SMTP_ALLOW_INSECURE_LOCAL=true

# Leave both empty for a relay that authenticates by IP address.
SMTP_USER=
SMTP_PASS=

# Sender, "Name <address>" or a plain address. Required.
SMTP_FROM="Synergy Careers <careers@example.com>"

# Recipients of new-application and talent-pool alerts (comma-separated, up to
# 10). Production: hr@synergypharma.lk
HR_NOTIFICATION_EMAIL=hr@example.com

# Optional. Recipients of contact form messages. Empty = HR_NOTIFICATION_EMAIL.
# Production: info@synergypharma.lk
CONTACT_NOTIFICATION_EMAIL=

# --- Scheduled maintenance and monitoring ------------------------------------

# Bearer token for /api/cron/maintenance (at least 32 characters). Vercel Cron
# sends it automatically when this variable is set. Empty disables the route.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional. Bearer token that unlocks the deep checks of /api/health (the
# spreadsheet's tabs and access to the Drive folder). At least 32 characters:
# openssl rand -hex 32
HEALTHCHECK_TOKEN=

# --- Client IP detection (rate limiting, audit log) --------------------------

# Rate limits are counted in memory, per server instance - a spreadsheet row per
# request would use up the Sheets API quota - so they are a speed bump, not a
# quota. The durable limits are one application per job per candidate and the
# admin account lockout.

# Not needed on Vercel. Behind your own reverse proxy, the header the proxy sets
# and overwrites, e.g. x-real-ip (nginx) or cf-connecting-ip (Cloudflare).
TRUSTED_IP_HEADER=

# Optional (1-10, default 1). Without TRUSTED_IP_HEADER, the client IP is read
# from X-Forwarded-For, skipping this many proxies from the right.
TRUSTED_PROXY_COUNT=

# --- Data retention ----------------------------------------------------------

# Months an application or talent profile is kept after it was submitted
# (1-120, default 12). The privacy policy promises 12 months.
DATA_RETENTION_MONTHS=12

# true = the maintenance job permanently deletes overdue records (and their CVs
# in Drive). false = overdue records are only reported. Read the data retention
# section of DEPLOYMENT.md before enabling it on a spreadsheet that holds
# imported historic records.
RETENTION_AUTO_PURGE=false

# Months of AuditLog rows to keep (1-120, default 24); the maintenance job
# deletes older ones. A Google spreadsheet holds at most 10 million cells in
# total and the audit log is the one tab that grows for ever, so this is what
# stops the document filling up. Keep it at least as long as the retention
# period you have to be able to prove.
AUDIT_RETENTION_MONTHS=24

# MONGODB_*, S3_*, DATABASE_URL and PGSSLROOTCERT from earlier releases are no
# longer read: the data store is the spreadsheet and the Drive folder above.
# AUTH_SECRET and ADMIN_PASSWORD are gone too - administrators sign in with
# their own accounts (npm run admin:user). Remove all of them.
