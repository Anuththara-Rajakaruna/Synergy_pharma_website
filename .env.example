# -----------------------------------------------------------------------------
# Synergy Pharmaceutical Corporation website: environment variables
#
# Local development:  cp .env.example .env.local
#   The values below work with the local services described in README.md
#   (MongoDB on 127.0.0.1:27017, an S3-compatible server on 127.0.0.1:8333 and
#   the SMTP capture server from `npm run test:smtp-sink`).
#
# Production: set every variable in the hosting provider's dashboard (Vercel:
#   Project Settings > Environment Variables). Never commit real credentials.
#   DEPLOYMENT.md section 4 lists each variable with its production value.
#
# Check a configuration with `npm run db:check`. The server also logs every
# problem at start-up as a `config.problem` event.
# -----------------------------------------------------------------------------

# --- Site --------------------------------------------------------------------

# Public URL of the site, without a trailing slash. Used for canonical URLs,
# sitemap.xml, links in emails and the same-origin check on form submissions.
# NEXT_PUBLIC_ variables are compiled into the build: redeploy after changing.
# Production: https://www.synergypharma.lk (https is required in production).
# Do not leave this set to an empty value; remove the line instead.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Empty disables analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# --- MongoDB (required) ------------------------------------------------------

# Connection string. Production: the MongoDB Atlas SRV string of a database
# user that only has readWrite on MONGODB_DB_NAME, for example
#   mongodb+srv://synergy-web:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017

# Database name. Required: the app never falls back to a default database.
MONGODB_DB_NAME=synergy_dev

# Optional. Connection pool size per server instance (1-200, default 10).
# MONGODB_MAX_POOL_SIZE=10

# --- Object storage for CVs (required) ---------------------------------------

# Private S3-compatible bucket (AWS S3, Cloudflare R2, MinIO, SeaweedFS).
# Browsers upload directly to it with presigned URLs, so the bucket needs a
# CORS rule for the site origin (DEPLOYMENT.md section 9, "Object storage bucket").
S3_BUCKET=synergy-dev-cvs

# AWS S3: leave S3_ENDPOINT empty and set a real region such as ap-south-1.
# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com (region auto).
# MinIO: its URL, with S3_REGION=us-east-1.
S3_ENDPOINT=http://127.0.0.1:8333

# Required for AWS S3. Defaults to "auto" when S3_ENDPOINT is set; "auto"
# without S3_ENDPOINT is rejected.
S3_REGION=

# Access key pair for the bucket. Production: a key that is limited to this
# bucket (s3:GetObject, s3:PutObject, s3:DeleteObject, s3:ListBucket).
# The local values match the SeaweedFS command in README.md; they are not secrets.
S3_ACCESS_KEY_ID=local-dev-access-key
S3_SECRET_ACCESS_KEY=local-dev-secret-key

# Optional. Endpoint browsers use for presigned URLs when it differs from
# S3_ENDPOINT (e.g. the server reaches MinIO as http://minio:9000 but browsers
# use https://files.example.com).
S3_PUBLIC_ENDPOINT=

# Optional. true or false. Defaults to true when S3_ENDPOINT is set and false
# for AWS S3 (virtual-hosted-style URLs).
S3_FORCE_PATH_STYLE=

# Optional. AES256, aws:kms or aws:kms:dsse, sent when documents are copied to
# their permanent location. AWS S3 only; leave empty for R2, MinIO and SeaweedFS.
S3_SERVER_SIDE_ENCRYPTION=

# --- Email (SMTP) ------------------------------------------------------------

# Every message is stored in the email_outbox collection first and delivered in
# the background; failed deliveries are retried by the maintenance job.
# Production: the provider's host, port 587 (STARTTLS, enforced) or 465 with
# SMTP_SECURE=true, plus SMTP_USER / SMTP_PASS.
SMTP_HOST=127.0.0.1
SMTP_PORT=2525

# true = implicit TLS (port 465). Defaults to true for port 465, otherwise false
# (STARTTLS, which is required unless SMTP_ALLOW_INSECURE_LOCAL applies).
SMTP_SECURE=false

# Local development only: allow plain-text SMTP to a mail catcher. Accepted only
# when SMTP_HOST is localhost, 127.0.0.1 or ::1. Remove it in production.
SMTP_ALLOW_INSECURE_LOCAL=true

# Leave both empty for a relay that authenticates by IP address.
SMTP_USER=
SMTP_PASS=

# Sender, "Name <address>" or a plain address. Required.
SMTP_FROM="Synergy Careers <careers@example.com>"

# Recipients of new-application and talent-pool alerts (comma-separated, up to
# 10). Production: hr@synergypharma.lk
HR_NOTIFICATION_EMAIL=hr@example.com

# Optional. Recipients of contact form messages. Empty = HR_NOTIFICATION_EMAIL.
# Production: info@synergypharma.lk
CONTACT_NOTIFICATION_EMAIL=

# --- Scheduled maintenance and monitoring ------------------------------------

# Bearer token for /api/cron/maintenance (at least 32 characters). Vercel Cron
# sends it automatically when this variable is set. Empty disables the route.
# Generate with: openssl rand -hex 32
CRON_SECRET=

# Optional. Bearer token that unlocks the deep checks of /api/health
# (bucket access, indexes). At least 32 characters: openssl rand -hex 32
HEALTHCHECK_TOKEN=

# --- Client IP detection (rate limiting, audit log) --------------------------

# Not needed on Vercel. Behind your own reverse proxy, the header the proxy sets
# and overwrites, e.g. x-real-ip (nginx) or cf-connecting-ip (Cloudflare).
TRUSTED_IP_HEADER=

# Optional (1-10, default 1). Without TRUSTED_IP_HEADER, the client IP is read
# from X-Forwarded-For, skipping this many proxies from the right.
TRUSTED_PROXY_COUNT=

# --- Data retention ----------------------------------------------------------

# Months an application or talent profile is kept after it was submitted
# (1-120, default 12). The privacy policy promises 12 months.
DATA_RETENTION_MONTHS=12

# true = the maintenance job permanently deletes overdue records (and their CVs).
# false = overdue records are only reported. Read DEPLOYMENT.md section 8
# before enabling it on a database with migrated historic data.
RETENTION_AUTO_PURGE=false

# --- Legacy PostgreSQL import (one-time) -------------------------------------

# Only read by `npm run db:migrate:postgres`. Remove after the import.
# DATABASE_URL=postgresql://careers_reader:<password>@legacy-db.example.com:5432/synergy
# PGSSLROOTCERT=/path/to/provider-ca.pem

# AUTH_SECRET and ADMIN_PASSWORD from the previous release are no longer used:
# administrators sign in with their own accounts (npm run admin:user).
